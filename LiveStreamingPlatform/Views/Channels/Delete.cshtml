@model LiveStreamingPlatform.Models.Channel

@{
    ViewData["Title"] = "Delete Channel";
}

<div class="container mt-4">
    <h1>Delete Channel</h1>

    <div class="alert alert-danger">
        Are you sure you want to delete this channel?
    </div>

    <div class="card">
        <div class="card-body">
            <h4>@Model.Name</h4>

            <p>
                <strong>Description:</strong>
                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description" : Model.Description)
            </p>

            <p>
                <strong>Current Title:</strong>
                @(string.IsNullOrWhiteSpace(Model.CurrentTitle) ? "No stream title" : Model.CurrentTitle)
            </p>

            <p>
                <strong>Category:</strong>
                @(string.IsNullOrWhiteSpace(Model.Category) ? "No category" : Model.Category)
            </p>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>