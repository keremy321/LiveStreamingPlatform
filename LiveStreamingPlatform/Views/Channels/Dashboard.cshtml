@model LiveStreamingPlatform.Models.Channel

@{
    ViewData["Title"] = "Streamer Dashboard";
}

<div class="container mt-4">
    <h1>Streamer Dashboard</h1>

    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h3>@Model.Name</h3>

                    @if (Model.IsLive)
                    {
                        <span class="badge bg-danger">LIVE</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">OFFLINE</span>
                    }

                    <p class="mt-3">
                        <strong>Current Title:</strong>
                        @(string.IsNullOrWhiteSpace(Model.CurrentTitle) ? "No stream title" : Model.CurrentTitle)
                    </p>

                    <p>
                        <strong>Category:</strong>
                        @(string.IsNullOrWhiteSpace(Model.Category) ? "No category" : Model.Category)
                    </p>
                </div>

                <div>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                        View Channel
                    </a>

                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                        Edit Channel
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            Stream Settings
        </div>

        <div class="card-body">
            <p>
                <strong>Server URL:</strong>
            </p>

            <input class="form-control mb-3" value="rtmp://localhost:1935/live" readonly />

            <p>
                <strong>Stream Key:</strong>
            </p>

            <input class="form-control mb-3" value="@Model.StreamKey" readonly />

            <form asp-action="RegenerateStreamKey" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-warning">
                    Regenerate Stream Key
                </button>
            </form>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            Stream Status
        </div>

        <div class="card-body">
            @if (Model.IsLive)
            {
                <form asp-action="EndLive" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger">
                        End Stream
                    </button>
                </form>
            }
            else
            {
                <form asp-action="GoLive" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-success">
                        Go Live
                    </button>
                </form>
            }
        </div>
    </div>
</div>