@model LiveStreamingPlatform.Models.Channel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container-fluid mt-3">
    <div class="row">
        <!-- Video Area -->
        <div class="col-lg-9">
            <div class="bg-dark text-white d-flex align-items-center justify-content-center rounded" style="height: 500px;">
                @if (Model.IsLive)
                {
                    <h3>Live stream player will be here</h3>
                }
                else
                {
                    <div class="text-center">
                        <h3>@Model.Name is offline</h3>
                        <p class="text-secondary">The stream will appear here when the channel goes live.</p>
                    </div>
                }
            </div>

            <div class="mt-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h2>@Model.Name</h2>

                        @if (Model.IsLive)
                        {
                            <span class="badge bg-danger">LIVE</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">OFFLINE</span>
                        }

                        <p class="mt-2 mb-1">
                            <strong>Title:</strong>
                            @(string.IsNullOrWhiteSpace(Model.CurrentTitle) ? "No stream title" : Model.CurrentTitle)
                        </p>

                        <p class="mb-1">
                            <strong>Category:</strong>
                            @(string.IsNullOrWhiteSpace(Model.Category) ? "No category" : Model.Category)
                        </p>

                        <p class="text-muted">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No channel description." : Model.Description)
                        </p>
                    </div>

                    <div>
                        <button class="btn btn-primary">Follow</button>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit Channel</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chat Area -->
        <div class="col-lg-3">
            <div class="card" style="height: 500px;">
                <div class="card-header">
                    Live Chat
                </div>

                <div class="card-body overflow-auto">
                    <p class="text-muted">Chat messages will appear here.</p>
                </div>

                <div class="card-footer">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Send a message..." disabled />
                        <button class="btn btn-primary" disabled>Send</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>